# --- Notion ---
# Token de integración de Notion (obligatorio)
NOTION_KEY=

# IDs de las bases de datos de Notion (obligatorios, uno por cada endpoint /{DB}.json)
WEB_DB=
ACTIVIDADES_DB=
AEDM_DB=
ESCUELA_DB=
INICIO_DB=
PROYECTOS_DB=

# --- Servidor ---
# Puerto de la API pública (por defecto 8000)
PORT=8000
# Puerto de los endpoints de administración/caché (por defecto 8080)
ADMIN_PORT=8080
